void colourPop() {
  color black = #000000;
  color white = #FFFFFF;
  color red = #E30302;
  color mDarkRed = #BF2323;
  color darkRed = #981A1A;
  color lGray = #D6D6D6;
  color gray = #B9B9B9;
  color dGray = #484848;
  color xGray = #151515;
  // Definite Colours
  BG = black;
  clear = white;
  textSong = red;
  textArtist = mDarkRed;
  islandC = xGray;
  albumColour = darkRed;
  // Dependant Colours
  exitButtonC = white;
  exitButtonCH = red;
  exitButtonCN = white;
  exitButtonCHN = gray;
  playButtonBox = darkRed;
  playButtonTri = red;
  playButtonBoxH = red;
  playButtonTriH = mDarkRed;
  playButtonBoxN = dGray;
  playButtonTriN = lGray;
  playButtonBoxHN = lGray;
  playButtonTriHN = gray;
  pauseButtonBox = darkRed;
  pauseButtonRec = red;
  pauseButtonBoxH = red;
  pauseButtonRecH = mDarkRed;
  pauseButtonBoxN = dGray;
  pauseButtonRecN = lGray;
  pauseButtonBoxHN = lGray;
  pauseButtonRecHN = gray;
  nextButtonBox = darkRed;
  nextButtonTri = red;
  nextButtonRec = red;
  nextButtonBoxH = red;
  nextButtonTriH = mDarkRed;
  nextButtonRecH = mDarkRed;
  nextButtonBoxN = dGray;
  nextButtonTriN = lGray;
  nextButtonRecN = lGray;
  nextButtonBoxHN = lGray;
  nextButtonTriHN = gray;
  nextButtonRecHN = gray;
  lastButtonBox = darkRed;
  lastButtonTri = red;
  lastButtonRec = red;
  lastButtonBoxH = red;
  lastButtonTriH = mDarkRed;
  lastButtonRecH = mDarkRed;
  lastButtonBoxN = dGray;
  lastButtonTriN = lGray;
  lastButtonRecN = lGray;
  lastButtonBoxHN = lGray;
  lastButtonTriHN = gray;
  lastButtonRecHN = gray;
  shuffleBox = darkRed;
  shuffleTri = red;
  shuffleBoxH = red;
  shuffleTriH = mDarkRed;
  shuffleBoxN = dGray;
  shuffleTriN = lGray;
  shuffleBoxHN = lGray;
  shuffleTriHN = gray;
  if (nightToggle == false) {
    playB  = playButtonBox;
    playT  = playButtonTri;
    playBH = playButtonBoxH;
    playTH = playButtonTriH;
    pauseB  = pauseButtonBox;
    pauseR  = pauseButtonRec;
    pauseBH = pauseButtonBoxH;
    pauseRH = pauseButtonRecH;
    nextB  = nextButtonBox;
    nextT  = nextButtonTri;
    nextR  = nextButtonRec;
    nextBH = nextButtonBoxH;
    nextTH = nextButtonTriH;
    nextRH = nextButtonRecH;
    shuffleB  = shuffleBox;
    shuffleT  = shuffleTri;
    shuffleBH = shuffleBoxH;
    shuffleTH = shuffleTriH;
    lastB  = lastButtonBox;
    lastT  = lastButtonTri;
    lastR  = lastButtonRec;
    lastBH = lastButtonBoxH;
    lastTH  = lastButtonTriH;
    lastRH = lastButtonRecH;
    exit = exitButtonC;
    exitHo = exitButtonCH;
  } else {
    playB  = playButtonBoxN;
    playT  = playButtonTriN;
    playBH = playButtonBoxHN;
    playTH = playButtonTriHN;
    pauseB  = pauseButtonBoxN;
    pauseR  = pauseButtonRecN;
    pauseBH = pauseButtonBoxHN;
    pauseRH = pauseButtonRecHN;
    nextB  = nextButtonBoxN;
    nextT  = nextButtonTriN;
    nextR  = nextButtonRecN;
    nextBH = nextButtonBoxHN;
    nextTH = nextButtonTriHN;
    nextRH = nextButtonRecHN;
    shuffleB  = shuffleBoxN;
    shuffleT  = shuffleTriN;
    shuffleBH = shuffleBoxHN;
    shuffleTH = shuffleTriHN;
    lastB  = lastButtonBoxN;
    lastT  = lastButtonTriN;
    lastR  = lastButtonRecN;
    lastBH = lastButtonBoxHN;
    lastTH  = lastButtonTriHN;
    lastRH = lastButtonRecHN;
    exit = exitButtonCN;
    exitHo = exitButtonCHN;
  }
} // End colourPop
